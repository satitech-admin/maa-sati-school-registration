function setup() {
  const p = PropertiesService.getScriptProperties();
  if (p.getProperty('SHEET_ID')) { console.log('Registration spreadsheet already configured.'); return; }
  const book = SpreadsheetApp.create('Maa Sati - One Week Session Registrations');
  const s = book.getSheets()[0]; s.setName('Registrations');
  s.appendRow(['Timestamp','Registration ID','Request ID','Student Name','Class','School','City','Email','Guardian WhatsApp','Guardian Consent','Email Status','Fee Status']);
  s.setFrozenRows(1); s.getRange(1,1,1,12).setBackground('#164e43').setFontColor('#ffffff').setFontWeight('bold'); s.autoResizeColumns(1,12);
  p.setProperty('SHEET_ID',book.getId()); console.log('Private registration spreadsheet: '+book.getUrl());
}
function clean_(v,max) { const t=String(v||'').trim(); if(t.length<2||t.length>max||/[\x00-\x1f\x7f]/.test(t)) throw new Error('Invalid details'); return t; }
function cell_(v) { return /^[=+@\-]/.test(v) ? "'"+v : v; }
function submitRegistration(d) {
  if(!d || typeof d!=='object' || d.website || d.consent!=='on') throw new Error('Invalid registration');
  const name=clean_(d.name,80), school=clean_(d.school,140), city=clean_(d.city,80);
  const email=String(d.email||'').trim().toLowerCase(), phone=String(d.phone||'').trim(), cls=String(d.className||''), req=String(d.requestId||'');
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)||email.length>160||! /^[6-9][0-9]{9}$/.test(phone)||! /^(9|10|11|12)$/.test(cls)||! /^[0-9a-f-]{36}$/.test(req)) throw new Error('Invalid details');
  const lock=LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const sid=PropertiesService.getScriptProperties().getProperty('SHEET_ID');
    if(!sid) throw new Error('Registration not configured');
    const s=SpreadsheetApp.openById(sid).getSheetByName('Registrations');
    const rows=s.getDataRange().getValues();
    // Retry protection + one registration for each student/email/school combination.
    for(let i=1;i<rows.length;i++) if(rows[i][2]===req || (String(rows[i][7]).toLowerCase()===email && String(rows[i][3]).replace(/^'/,'').toLowerCase()===name.toLowerCase() && String(rows[i][5]).replace(/^'/,'').toLowerCase()===school.toLowerCase())) return {id:rows[i][1],sent:rows[i][10]==='Sent'};
    // Limit repeated requests to the same recipient and guardian per day.
    const today=Utilities.formatDate(new Date(),'Asia/Kolkata','yyyy-MM-dd');
    const recent=rows.slice(1).filter(r=>r[0] instanceof Date && Utilities.formatDate(r[0],'Asia/Kolkata','yyyy-MM-dd')===today);
    if(recent.filter(r=>r[7]===email||String(r[8]).replace(/^'/,'')===phone).length>=3) throw new Error('Please contact the session team');
    const id='MST-'+Utilities.formatDate(new Date(),'Asia/Kolkata','yyMMdd')+'-'+Utilities.getUuid().slice(0,8).toUpperCase();
    s.appendRow([new Date(),id,req,cell_(name),cls,cell_(school),cell_(city),cell_(email),"'"+phone,'Agreed - parent/guardian permission declared','Pending','Not verified']);
    const row=s.getLastRow(); SpreadsheetApp.flush();
    let sent=false;
    try {
      if(MailApp.getRemainingDailyQuota()>0){
        MailApp.sendEmail({to:email,subject:'Registration received | Maa Sati Technologies | '+id,name:'Maa Sati Technologies',body:'Hello!\n\nYour registration for the Maa Sati Technologies one-week AI & Coding session has been received successfully.\n\nRegistration ID: '+id+'\nClass: '+cls+'\n\nFee: INR 199 per student. This message confirms form submission only; it does not confirm payment or a seat. Our team will share the schedule and payment instructions.\n\nYou will explore coding basics, HTML, CSS, JavaScript, AI tools and prompt engineering, and build a mini project. Certificate approval requires project submission and review.\n\nKeep your registration ID. For help, reply to this email.\n\nMaa Sati Technologies\nBuild. Learn. Grow.'});
        sent=true;
      }
    }catch(err){sent=false;}
    s.getRange(row,11).setValue(sent?'Sent':'Pending - manual follow-up required');
    return {id:id,sent:sent};
  } finally {lock.releaseLock();}
}
