ng:12px;outline:none}input:focus,select:focus{border-color:#4e7951;box-shadow:0 0 0 3px #e6f1dd}input::placeholder{color:#8c9789;font-size:12px}.hint{font-size:10px;color:var(--muted);line-height:1.6;margin:5px 0 0}.consent{display:flex;gap:9px;align-items:flex-start;font-size:11px;line-height:1.65;font-weight:400;color:var(--muted);margin:20px 0 15px}.consent input{width:16px;min-height:16px;margin:3px 0;accent-color:var(--green);flex-shrink:0}.submit{width:100%;border:0;border-radius:11px;padding:16px;background:var(--green);color:white;font:600 14px 'DM Sans';display:flex;justify-content:space-between;cursor:pointer;transition:transform .2s,background .2s}.submit:hover{background:#236457;transform:translateY(-1px)}.submit:disabled{opacity:.6;cursor:wait}.trust{text-align:center;font-size:10px;color:var(--muted);margin:13px 0 0}.notice{font-size:11px;line-height:1.7;background:#f2f6e8;padding:13px;border-radius:10px;margin-top:20px;color:#52634b}#status{font-size:13px;line-height:1.7;margin:14px 0;color:#9e3428}.success{padding:35px 10px;text-align:center}.success .check{background:var(--lime);border-radius:50%;width:70px;height:70px;display:grid;place-items:center;font-size:32px;margin:auto}.success p{line-height:1.8;color:var(--muted)}#regId{display:block;background:#f1f5e7;padding:15px;border-radius:10px;font:600 20px 'Space Grotesk';letter-spacing:1px}.hp{position:absolute;left:-10000px}.footer{max-width:1180px;border-top:1px solid #dbe0d2;margin:auto;padding:22px 0;display:flex;justify-content:space-between;font-size:11px;color:var(--muted);gap:15px}.footer a{text-decoration:none}.footer a:hover{text-decoration:underline}[hidden]{display:none!important}@keyframes float{50%{transform:translateY(-5px) rotate(8deg)}}@media(max-width:900px){main{gap:26px;padding-top:30px}h1{font-size:47px}.card{padding:24px}.footer{margin:0 30px}}@media(max-width:680px){header{padding:19px 20px}.brand{font-size:16px}.brand small{font-size:8px}.pill{font-size:9px;padding:7px}main{grid-template-columns:1fr;padding:30px 20px 45px;gap:28px}h1{font-size:49px}.intro{font-size:14px}.lab{margin-top:20px}.benefits{margin-bottom:15px}.card{padding:23px 19px}.grid{gap:16px 12px}.footer{flex-direction:column;margin:0 20px}.fee b{font-size:28px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\n</style></head><body>\n<header><div class=\"brand\"><div class=\"symbol\" aria-hidden=\"true\">&lt;/&gt;</div><div>MAA SATI<small>TECHNOLOGIES</small></div></div><span class=\"pill\"><span class=\"dot\"></span>STUDENT REGISTRATION</span></header>\n<main><section><div class=\"eyebrow\">One week. Your first creation.</div><h1>Don't just use tech.<br><em>Learn to build it.</em></h1><p class=\"intro\">Apne ideas ko real projects mein badlo. Coding, AI aur better prompts seekho — step by step, bilkul basics se.</p><div class=\"tags\"><span>Classes 9–12</span><span>Beginner friendly</span><span>1-week session</span></div>\n<div class=\"lab\"><div class=\"lab-top\"><span>YOUR FIRST BUILD</span><span>● LIVE LEARNING</span></div><div class=\"code\"><b>&lt;your-future&gt;</b><br>&nbsp; idea + code + AI<br>&nbsp; = something you created ✦<br><b>&lt;/your-future&gt;</b></div><div class=\"lab-bottom\"><span class=\"orbit\" aria-hidden=\"true\">✳</span><div><strong>Small steps. Real possibilities.</strong><small>Think it. Build it. Showcase it.</small></div></div></div>\n<div class=\"benefits\"><div><strong>01 / Code with confidence</strong>HTML, CSS & JavaScript basics.</div><div><strong>02 / Work smarter with AI</strong>AI tools, vibe coding & prompts.</div><div><strong>03 / Make a mini project</strong>Build and present your own idea.</div><div><strong>04 / Earn your certificate</strong>After project submission & approval.</div></div><div class=\"fee\"><b>₹199</b><span>per student · one-week session<br>Payment details shared by the team.</span></div></section>\n<section class=\"card\" aria-labelledby=\"formTitle\"><div class=\"card-top\"><span class=\"eyebrow\">Start something new ↗</span><span class=\"step\">2 MINUTES TO APPLY</span></div><h2 id=\"formTitle\">Your creator journey starts here.</h2><p class=\"sub\">Details bharo, registration submit karo. Confirmation aapke email par aayega. All fields are required.</p>\n<form id=\"registration\"><div class=\"section-title\">01 &nbsp; STUDENT DETAILS</div><div class=\"grid\">\n<div class=\"wide\"><label for=\"name\">Student's full name</label><input id=\"name\" name=\"name\" autocomplete=\"name\" placeholder=\"Enter your full name\" required minlength=\"2\" maxlength=\"80\"></div>\n<div><label for=\"className\">Class</label><select id=\"className\" name=\"className\" required><option value=\"\">Select class</option><option value=\"9\">Class 9</option><option value=\"10\">Class 10</option><option value=\"11\">Class 11</option><option value=\"12\">Class 12</option></select></div>\n<div><label for=\"city\">City / town</label><input id=\"city\" name=\"city\" placeholder=\"e.g. Indore\" required minlength=\"2\" maxlength=\"80\"></div>\n<div class=\"wide\"><label for=\"school\">School name</label><input id=\"school\" name=\"school\" placeholder=\"Enter your school's full name\" required minlength=\"2\" maxlength=\"140\"></div>\n</div><div class=\"divider\"></div><div class=\"section-title\">02 &nbsp; CONTACT DETAILS</div><div class=\"grid\">\n<div class=\"wide\"><label for=\"email\">Confirmation email</label><input id=\"email\" name=\"email\" type=\"email\" autocomplete=\"email\" placeholder=\"you@example.com\" required maxlength=\"160\"><p class=\"hint\">Student email, or parent's email if you do not have one.</p></div>\n<div class=\"wide\"><label for=\"phone\">Parent / guardian WhatsApp number</label><input id=\"phone\" name=\"phone\" type=\"tel\" inputmode=\"numeric\" autocomplete=\"tel-national\" pattern=\"[6-9][0-9]{9}\" maxlength=\"10\" placeholder=\"10-digit Indian mobile number\" required><p class=\"hint\">Used only for session schedule and registration updates.</p></div></div>\n<div class=\"hp\" aria-hidden=\"true\"><label for=\"website\">Leave empty</label><input id=\"website\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></div>\n<label class=\"consent\"><input name=\"consent\" type=\"checkbox\" required><span>I confirm these details are correct and my parent/guardian agrees to this registration. Maa Sati Technologies may contact us about this session.</span></label>\n<button class=\"submit\" id=\"submit\" type=\"submit\"><span>Register for the session</span><span aria-hidden=\"true\">↗</span></button><p class=\"trust\">Private registration · No online payment on this form</p><div id=\"status\" role=\"alert\"></div>\n<div class=\"notice\"><strong>Good to know:</strong> Registration is an application, not payment or a confirmed seat. The team will share the schedule and next steps. A mini project is compulsory for certificate approval. Best projects may be considered for awards; public showcases require separate permission.</div></form>\n<div id=\"success\" class=\"success\" hidden tabindex=\"-1\"><div class=\"check\">✓</div><h2>You're on the list!</h2><p>Aapka registration save ho gaya hai.</p><span id=\"regId\"></span><p id=\"emailStatus\"></p><p>Keep your registration ID. Our team will share the schedule and payment instructions. See you in the session!</p></div></section></main>\n<footer class=\"footer\"><span>© Maa Sati Technologies · Build. Learn. Grow.</span><span><a href=\"mailto:www.satitechinfo@gmail.com\">Contact the session team ↗</a></span></footer>\n<script>\nconst form=document.getElementById('registration'), button=document.getElementById('submit'), statusEl=document.getElementById('status');\nlet requestId=crypto.randomUUID();\nform.addEventListener('submit',function(e){e.preventDefault();if(!form.reportValidity())return;button.disabled=true;button.firstElementChild.textContent='Saving your registration…';statusEl.textContent='';\nconst data=Object.fromEntries(new FormData(form));data.requestId=requestId;\nif(typeof google==='undefined'||!google.script){statusEl.textContent='Please open the live registration link to submit this form.';button.disabled=false;button.firstElementChild.textContent='Register for the session';return;}\ngoogle.script.run.withSuccessHandler(function(r){form.hidden=true;document.getElementById('formTitle').textContent='Registration received';document.getElementById('regId').textContent=r.id;document.getElementById('emailStatus').textContent=r.sent?'Confirmation email sent. Please check your inbox and spam folder.':'Your registration is saved. Email confirmation is pending; contact the team with your registration ID if needed.';const s=document.getElementById('success');s.hidden=false;s.focus();}).withFailureHandler(function(){statusEl.textContent='We could not confirm your submission. Check your connection and try again. Retrying will not create a duplicate registration.';button.disabled=false;button.firstElementChild.textContent='Register for the session';}).submitRegistration(data);\n});\n</script></body></html>").setTitle('Maa Sati Technologies | Registration').addMetaTag('viewport','width=device-width, initial-scale=1').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
